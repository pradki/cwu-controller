[Unit]
Description=CWU PV Surplus Controller
After=network.target

[Service]
Type=simple
User=sqna
WorkingDirectory=/home/sqna/cave/raspberry/cwu-controller
ExecStart=/home/sqna/venv/cave/bin/python /home/sqna/cave/raspberry/cwu-controller/main.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
